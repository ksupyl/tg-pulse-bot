# Скопируй этот файл в .env и заполни своими значениями. Сам .env в git не попадает.

# --- Обязательные ---
BOT_TOKEN=your_telegram_bot_token_here
# Ключ шифрования пользовательских Gemini-ключей. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Сохрани копию: потеряешь ключ — все сохранённые ключи пользователей станут нечитаемыми
ENCRYPTION_KEY=

# --- Доступ ---
# Общий ключ Gemini. Им пользуются только админы из ALLOWED_USERS, остальные — своим через /set_key
DEFAULT_GEMINI_KEY=your_gemini_api_key_here
# Telegram ID админов через запятую
ALLOWED_USERS=123456789,987654321

# --- Хранилище ---
DATABASE_PATH=tg_pulse.db
BUFFER_TTL_HOURS=48
